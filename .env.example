# =============================================================================
# landing-au — Variables de entorno
# Copia este archivo a `.env` en el servidor (o en local) y rellena los valores.
# `.env` está en .gitignore: nunca se sube al repo.
# =============================================================================

# --- Formulario de contacto (SMTP / nodemailer) -------------------------------
# Sin estas 6 variables el formulario "Solicitar diagnóstico" NO envía nada:
# la server action devuelve error y lo registra en logs con "[booking] Missing SMTP".
# Ejemplo con un proveedor tipo Zoho/Google/correo del dominio:
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Buzón que recibe las solicitudes
BOOKING_EMAIL_TO=comercial@ilaxus.com.co
# Remitente verificado por el proveedor SMTP (normalmente el mismo SMTP_USER)
BOOKING_EMAIL_FROM=

# --- Analítica (opcional, BUILD-TIME) ----------------------------------------
# IMPORTANTE: son variables de build. El sitio se genera estático, así que se
# incrustan en el bundle al compilar la imagen (no en runtime).
#   - En local: exportarlas antes de `pnpm build`.
#   - En producción: definirlas como "Variables" (vars) del repo en GitHub y se
#     pasan como build-args en .github/workflows/docker-build.yml.
# Si se dejan vacías, no se carga ningún script de analítica.
# Google Tag Manager (contenedor GTM). Público; si se deja vacío usa GTM-M8WXBNJJ.
NEXT_PUBLIC_GTM_ID=
# GA4: crea la propiedad en https://analytics.google.com y pega el ID "G-XXXXXXX".
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Cloudflare Web Analytics: token del beacon desde el panel de Cloudflare.
# (Alternativa sin código: activar Web Analytics en el panel de Cloudflare.)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
